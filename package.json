{
  "name": "ged-language-tools",
  "displayName": "GED Language Tools",
  "description": "Helper tool for .ged files for the ci-lib-spring-gui library.",
  "version": "1.0.1",
  "publisher": "cook-industries",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cook-Industries/ged-language-tools.git"
  },
  "homepage": "https://github.com/cook-industries/ged-language-tools",
  "icon": "images/ged-icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ged",
        "aliases": [
          "GED",
          "ged"
        ],
        "extensions": [
          ".ged"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ged",
        "scopeName": "source.ged",
        "path": "./syntaxes/ged.tmLanguage.json"
      }
    ],
    "commands": [],
    "configurationDefaults": {},
    "configuration": {
      "title": "GED Language Tools",
      "properties": {
        "gedLanguageTools.libraryVersion": {
          "type": "string",
          "enum": [
            "4.0"
          ],
          "enumDescriptions": [
            "ci-lib-spring-gui 4.0.0"
          ],
          "default": "4.0",
          "description": "The ci-lib-spring-gui .ged language version to validate against. Elements, properties, parameters, and values introduced or removed in other versions will be flagged."
        },
        "gedLanguageTools.enableLocationCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when .ged files are located outside of \"/resources/templates/\"."
        },
        "gedLanguageTools.ignoredLocationPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional folder paths (relative or absolute, forward slashes) where .ged files are allowed without triggering the location warning."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-json-languageservice": "^5.7.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}