{
    "uid": "login-modal",
    "type": "MODAL",
    "parameters": {
        "name": "TEST MODAL",
        "requestUrl": "/dummy3",
        "btnCenterName": "reset",
        "btnCenterFunction": "$$function$reset"
    },
    "children": [
        {
            "type": "table",
            "parameters": {
                "name": "test-table",
                "columnNames": [
                    "row1",
                    "row2",
                    "row3"
                ]
            },
            "children": [
                {
                    "type": "table_row",
                    "parameters": {
                        "tableName": "test-table"
                    },
                    "children": [
                        {
                            "type": "text",
                            "parameters": {
                                "text": "$$value$test-int",
                                "inline": true,
                                "tooltip": "test this shit!"
                            }
                        },
                        {
                            "type": "burger",
                            "children": [
                                {
                                    "type": "burger_item",
                                    "parameters": {
                                        "icon": "bi-bootstrap-reboot",
                                        "url": "/info/user-name",
                                        "text": "edit",
                                        "method": "DELETE"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "burger",
                            "children": [
                                {
                                    "type": "burger_item",
                                    "parameters": {
                                        "icon": "bi-bootstrap-reboot",
                                        "url": "/info/user-name",
                                        "text": "edit",
                                        "method": "PUT"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "COMPONENT",
                    "parameters": {
                        "path": "row.json"
                    }
                }
            ]
        },
        {
            "uid": "login-form",
            "type": "form",
            "parameters": {},
            "children": [
                {
                    "uid": "user-name",
                    "type": "textfield",
                    "parameters": {
                        "name": "Username",
                        "submitAs": "username",
                        "placeholder": "user@rittal.de",
                        "tooltip": "test tooltip",
                        "infoText": "click-me",
                        "infoUrl": "/info/user-name",
                        "disabled": true,
                        "value": "$$value$number-field-id"
                    }
                },
                {
                    "type": "tag",
                    "parameters": {
                        "name": "tag-input",
                        "submitAs": "tags",
                        "enforceWhitelist": true,
                        "fetchUrl": "/tags/fetch",
                        "searchUrl": "/tags/search"
                    }
                },
                {
                    "uid": "user-area",
                    "type": "textarea",
                    "parameters": {
                        "name": "Username",
                        "submitAs": "textarea",
                        "placeholder": "user@rittal.de",
                        "tooltip": "test tooltip"
                    }
                },
                {
                    "uid": "$$value$number-field-id",
                    "type": "number",
                    "attributes": {
                        "$$value$attribute-test": "$$value$number-field-id"
                    },
                    "parameters": {
                        "name": "Number Test",
                        "submitAs": "number",
                        "placeholder": "0",
                        "onEnterPress": "login-modal-right-btn"
                    }
                },
                {
                    "type": "CHECKBOX",
                    "classes": [],
                    "attributes": {},
                    "parameters": {
                        "name": "legend",
                        "submitAs": "checkbox",
                        "infoText": "click-me"
                    },
                    "children": [
                        {
                            "type": "INPUT_VALUE",
                            "parameters": {
                                "text": "checkbox 1",
                                "value": "1"
                            }
                        },
                        {
                            "type": "INPUT_VALUE",
                            "parameters": {
                                "text": "checkbox 2",
                                "value": "2"
                            }
                        }
                    ]
                },
                {
                    "uid": "files",
                    "type": "file",
                    "parameters": {
                        "name": "files",
                        "submitAs": "files",
                        "multiple": false,
                        "infoText": "$$text$files-motherfucker",
                        "accept": [
                            ".pdf"
                        ]
                    }
                },
                {
                    "uid": "login-select",
                    "type": "select",
                    "parameters": {
                        "name": "select",
                        "submitAs": "select"
                    },
                    "children": [
                        {
                            "type": "INPUT_VALUE",
                            "classes": [],
                            "parameters": {
                                "text": "test select 1",
                                "value": "test value",
                                "checked": false
                            }
                        },
                        {
                            "type": "INPUT_VALUE",
                            "classes": [],
                            "parameters": {
                                "text": "$$text$test_name",
                                "value": "test value",
                                "checked": true
                            }
                        }
                    ]
                }
            ]
        }
    ]
}